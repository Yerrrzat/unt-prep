# PostgreSQL connection string (local docker-compose uses the values below)
DATABASE_URL="postgresql://unt:unt@localhost:5432/unt_prep?schema=public"

# Auth.js secret: generate with `openssl rand -base64 32`
AUTH_SECRET=""

# Public URL of the app behind the reverse proxy (needed when not on localhost)
# AUTH_URL="https://unt.example.kz"
# Trust X-Forwarded-* headers from the reverse proxy / load balancer
AUTH_TRUST_HOST=true
